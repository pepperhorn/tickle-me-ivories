{
  "name": "tickle-me-ivories",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w apps/studio --",
    "build": "npm run check:imports && npm run build -w packages/ivories && npm run build -w apps/studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:notation": "node scripts/e2e-notation.mjs",
    "test:e2e:plugin": "node scripts/e2e-plugin.mjs",
    "check:imports": "node scripts/check-public-imports.mjs",
    "check": "npm run test:geometry && npm run check:imports && npm run check:hosting && npm run test:scripts && npm run check:css -w packages/ivories",
    "test:geometry": "node tests/geometry-check.mjs",
    "lint": "oxlint",
    "sync:rig": "cp tools/strike-lab.html apps/studio/public/strike-lab.html && diff -q tools/strike-lab.html apps/studio/public/strike-lab.html",
    "test:scripts": "node --test scripts/inject-plugin.test.mjs scripts/check-hosting.test.mjs",
    "check:hosting": "node scripts/check-hosting.mjs"
  },
  "devDependencies": {
    "@playwright/test": "~1.62.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "oxlint": "^1.81.0",
    "playwright": "~1.62.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
